{
  "blockstates/{gem}_bars.json": {
    "multipart": [
      {
        "apply": {
          "model": "basegems:block/{gem}_bars_post"
        }
      },
      {
        "when": {
          "north": "true"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_side"
        }
      },
      {
        "when": {
          "north": "false"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_cap"
        }
      },
      {
        "when": {
          "south": "true"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_side_alt"
        }
      },
      {
        "when": {
          "south": "false"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_cap_alt",
          "y": 90
        }
      },
      {
        "when": {
          "west": "true"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_side_alt",
          "y": 90
        }
      },
      {
        "when": {
          "west": "false"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_cap",
          "y": 270
        }
      },
      {
        "when": {
          "east": "true"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_side",
          "y": 90
        }
      },
      {
        "when": {
          "east": "false"
        },
        "apply": {
          "model": "basegems:block/{gem}_bars_cap_alt"
        }
      }
    ]
  },
